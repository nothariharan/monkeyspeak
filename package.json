{
  "name": "monkeyspeak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package && node scripts/copy-ort-assets.js",
    "clean": "node -e \"const fs=require('fs');for(const p of['.next','node_modules/.cache','.turbo']){try{fs.rmSync(p,{recursive:true,force:true})}catch(e){}}\"",
    "dev": "next dev",
    "dev:backend": "node backend/index.js",
    "dev:turbo": "next dev --turbo",
    "dev:clean": "npm run clean && next dev",
    "build": "next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "lint": "next lint",
    "test": "jest"
  },
  "dependencies": {
    "@deepgram/sdk": "3.13.0",
    "@supabase/supabase-js": "^2.108.1",
    "double-metaphone": "^2.0.1",
    "fast-levenshtein": "^3.0.0",
    "framer-motion": "^11.3.19",
    "gsap": "^3.15.0",
    "next": "14.2.5",
    "onnxruntime-web": "^1.26.0",
    "react": "^18",
    "react-dom": "^18",
    "ws": "^8.20.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/fast-levenshtein": "^0.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "patch-package": "8.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
