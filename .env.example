# Deepgram (optional - browser STT works without these)

# Server-side Deepgram API key. Never commit real values; copy to .env.local.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Shared HMAC secret for Deepgram/run session grants.
# IMPORTANT: set the SAME value on Vercel AND Render (monkeyspeak-dg-proxy), or leave
# unset on both so they both fall back to DEEPGRAM_API_KEY. Never set it on only one side.
SESSION_SECRET=a-long-random-string

# Comma-separated browser origins allowed to hit the standalone Deepgram proxy.
# ALLOWED_ORIGINS=http://localhost:3000,https://monkeyspeak-delta.vercel.app

# WebSocket proxy URL the browser connects to for Deepgram STT.
# Render example: wss://YOUR-SERVICE.onrender.com/api/deepgram/proxy
# Local dev with backend: ws://localhost:8080/api/deepgram/proxy
# NEXT_PUBLIC_DEEPGRAM_PROXY_URL=wss://YOUR-SERVICE.onrender.com/api/deepgram/proxy

# Required for ephemeral key creation in the standalone backend token endpoint.
DEEPGRAM_PROJECT_ID=your_deepgram_project_id_here

# Supabase (global leaderboard — server only, never NEXT_PUBLIC_*)

# Project URL from Supabase dashboard → Settings → API.
SUPABASE_URL=https://your-project.supabase.co

# Service role key. Keep this secret; Next.js API routes use it to read/write scores.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional

# Server port (default 3000 for Next.js, 8080 for backend/index.js)
# PORT=3000

# Enable STT debug logs in the browser console.
# NEXT_PUBLIC_DEBUG_STT=true

# Verbose Deepgram WebSocket proxy logging on the backend.
# DEBUG_DG_PROXY=1

# Daily Deepgram seconds budgets (in-memory; soft on serverless).
# DEEPGRAM_SECONDS_PER_IP=300
# DEEPGRAM_SECONDS_GLOBAL=3600

# Migration script (scripts/apply-clarity-migration.mjs)
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=your-project-ref
# CONFIRM_MIGRATION=1
