# ── Deepgram (optional — browser STT works without these) ─────────────────────

# Server-side Deepgram API key. Never commit real values — copy to .env.local
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# WebSocket proxy URL the browser connects to for Deepgram STT (required for Brave/Edge on Vercel)
# Render example: wss://YOUR-SERVICE.onrender.com/api/deepgram/proxy
# Local dev with backend: ws://localhost:8080/api/deepgram/proxy
# NEXT_PUBLIC_DEEPGRAM_PROXY_URL=wss://YOUR-SERVICE.onrender.com/api/deepgram/proxy

# Required for ephemeral key creation in the standalone backend token endpoint
DEEPGRAM_PROJECT_ID=your_deepgram_project_id_here

# ── Optional ───────────────────────────────────────────────────────────────────

# Server port (default 3000 for Next.js, 8080 for backend/index.js)
# PORT=3000

# Enable STT debug logs in the browser console
# NEXT_PUBLIC_DEBUG_STT=true

# Verbose Deepgram WebSocket proxy logging on the backend
# DEBUG_DG_PROXY=1
